    "@storybook/vue3-vite": "^7.6.20",
    "@unlighthouse/nuxt": "^0.10.6",
    "autoprefixer": "^10.4.20",
    "nuxi": "^3.13.2",
    "nuxt": "^3.13.2",
    "nuxt-svgo": "^3.7.0",
